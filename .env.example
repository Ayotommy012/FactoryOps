# ============================================================================
# FactoryOps — Environment Example
#
# SAFE TO COMMIT. This file contains NO secrets.
# Copy this file to .env and fill in the values for your environment.
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# Application
# ────────────────────────────────────────────────────────────────────────────
APP_NAME=FactoryOps
APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=Africa/Lagos

# ────────────────────────────────────────────────────────────────────────────
# AI Provider: Meterless Runtime
# ────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=meterless
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_MODEL=meterless/auto
METERLESS_API_KEY=

# ────────────────────────────────────────────────────────────────────────────
# Zetaris Lightning JDBC
# ────────────────────────────────────────────────────────────────────────────
ZETARIS_USER=<zetaris-username>
ZETARIS_PASSWORD=<zetaris-password>
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@<host>:<port>
ZETARIS_JDBC_DRIVER_CLASS=com.zetaris.lightning.jdbc.LightningDriver
ZETARIS_JDBC_DRIVER_JAR=jdbc/ndp-jdbc-driver-2.4.3.1-7eff043-driver.jar
ZETARIS_QUERY_TIMEOUT_SECONDS=30

# ────────────────────────────────────────────────────────────────────────────
# FactoryOps application database (PostgreSQL 17)
# Note: This is the FactoryOps app's own relational DB — NOT Zetaris's internal PostgreSQL.
# ────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=factoryops
POSTGRES_USER=factoryops_app
POSTGRES_PASSWORD=<your-app-db-password>
POSTGRES_ADMIN_PASSWORD=<your-postgres-admin-password>
DATABASE_URL=postgresql+psycopg://factoryops_app:<password>@localhost:5433/factoryops

# ────────────────────────────────────────────────────────────────────────────
# Operational investigation (configurable defaults)
# ────────────────────────────────────────────────────────────────────────────
INVESTIGATION_MAX_STEPS=10
INVESTIGATION_TIMEOUT_SECONDS=120
EVIDENCE_MAX_ITEMS=50

# ────────────────────────────────────────────────────────────────────────────
# Safety and recovery
# ────────────────────────────────────────────────────────────────────────────
DRY_RUN=true
REQUIRE_APPROVAL_FOR_ACTIONS=true

# ────────────────────────────────────────────────────────────────────────────
# Testing
# ────────────────────────────────────────────────────────────────────────────
TESTING=false
